generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  bills     Bill[]
  expenses  Expense[]
}

model Bill {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  amount    Float
  date      DateTime
  fileName  String
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
  expenses  Expense[]
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billId      String?
  bill        Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
  type        String
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
}
